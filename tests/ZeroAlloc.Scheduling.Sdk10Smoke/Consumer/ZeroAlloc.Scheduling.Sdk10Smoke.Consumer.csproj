<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Scheduling and ZeroAlloc.Scheduling.InMemory packages with the oldest supported .NET
    SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. If a generator in the package references a newer Roslyn
    than the compiler that loads it, it is skipped with CS9057 and the generated AddPingJob method goes missing.
    CS9057 is an error here as well. Dependencies of the packages, ZeroAlloc.Serialisation 2.11.2,
    ZeroAlloc.Resilience 3.6.0, ZeroAlloc.StateMachine 1.8.2, ZeroAlloc.ValueObjects 2.4.3 and
    ZeroAlloc.Collections 1.3.2, also ship generators built against Roslyn 5.0, so no package in
    this build may be skipped.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      unset v; r=$(od -An -N4 -tx4 /dev/urandom | tr -d " ") && [ -n "$r" ] && v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s).r$r
      dotnet pack src/ZeroAlloc.Scheduling -c Release -o artifacts -p:Version=${v:?no random suffix}
      dotnet pack src/ZeroAlloc.Scheduling.InMemory -c Release -o artifacts -p:Version=${v:?no random suffix}
      cd tests/ZeroAlloc.Scheduling.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocSchedulingVersion=${v:?no random suffix}
    Each step stops when the random suffix cannot be generated; give each
    concurrent run its own worktree, because runs in one checkout share obj and bin.
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocSchedulingVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocSchedulingVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocSchedulingVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Scheduling" Version="[$(ZeroAllocSchedulingVersion)]" />
    <PackageReference Include="ZeroAlloc.Scheduling.InMemory" Version="[$(ZeroAllocSchedulingVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.*" />
  </ItemGroup>
</Project>
