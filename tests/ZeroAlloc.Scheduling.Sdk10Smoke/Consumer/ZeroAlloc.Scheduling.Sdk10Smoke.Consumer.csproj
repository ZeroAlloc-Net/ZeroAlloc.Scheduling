<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Scheduling and ZeroAlloc.Scheduling.InMemory packages with the oldest supported .NET
    SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. If a generator in the package references a newer Roslyn
    than the compiler that loads it, it is skipped with CS9057 and the generated AddPingJob method goes missing.
    CS9057 itself is not an error here: dependencies of the packages, ZeroAlloc.Serialisation 2.11.1,
    ZeroAlloc.Resilience 3.5.1, ZeroAlloc.StateMachine 1.8.1 and ZeroAlloc.ValueObjects 2.4.1, ship
    generators built against Roslyn 5.9, which this SDK skips with that warning. It stays visible in
    the build log and is tracked in ZeroAlloc-Net/.github#77. The consumer registers a job without
    state, so it needs none of them.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s)
      dotnet pack src/ZeroAlloc.Scheduling -c Release -o artifacts -p:Version=$v
      dotnet pack src/ZeroAlloc.Scheduling.InMemory -c Release -o artifacts -p:Version=$v
      cd tests/ZeroAlloc.Scheduling.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocSchedulingVersion=$v
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocSchedulingVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocSchedulingVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocSchedulingVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Scheduling" Version="[$(ZeroAllocSchedulingVersion)]" />
    <PackageReference Include="ZeroAlloc.Scheduling.InMemory" Version="[$(ZeroAllocSchedulingVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" />
  </ItemGroup>
</Project>
