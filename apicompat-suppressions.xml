<?xml version="1.0" encoding="utf-8"?>
<!--
  ZA.Scheduling v3.0.0 - intentional API breaks for the major version bump.

  Every package drops its net8.0 and net9.0 builds and ships net10.0 and net11.0 only, since
  .NET 8 and .NET 9 went out of support. Package validation reports each dropped framework as
  PKV006. The entries carry no package name, so these two cover every package in the repo.
  No public API is removed or changed.

  Generated by apicompat in suppression-file mode against the 2.6.0 baseline of each package,
  then annotated. Delete this file once 3.0.0 is the published baseline.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>PKV006</DiagnosticId>
    <Target>net8.0</Target>
  </Suppression>
  <Suppression>
    <DiagnosticId>PKV006</DiagnosticId>
    <Target>net9.0</Target>
  </Suppression>
</Suppressions>
