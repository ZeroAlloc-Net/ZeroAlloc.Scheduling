<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ZeroAlloc.Scheduling.Dashboard.Blazor</PackageId>
    <Description>Blazor component library for ZeroAlloc.Scheduling dashboard.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1*"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0"
                      Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1*"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0"
                      Condition="'$(TargetFramework)' == 'net11.0'" />
    <ProjectReference Include="..\ZeroAlloc.Scheduling\ZeroAlloc.Scheduling.csproj" />
  </ItemGroup>
</Project>
