<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Scheduling</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Source-generated zero-allocation background job scheduling for .NET.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- Pinned to 10.0.0 to satisfy ZeroAlloc.Serialisation's transitive minimum (Scheduling#15) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\ZeroAlloc.Scheduling.Generator\ZeroAlloc.Scheduling.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <PackageReference Include="ZeroAlloc.ValueObjects" Version="2.0.12" />
    <PackageReference Include="ZeroAlloc.Serialisation" Version="2.5.1" />
    <PackageReference Include="ZeroAlloc.StateMachine" Version="1.6.1" />
    <PackageReference Include="ZeroAlloc.Resilience" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZeroAlloc.Scheduling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Bundle the source generator into the NuGet package so consumers get it by
    referencing only ZeroAlloc.Scheduling. The standalone
    ZeroAlloc.Scheduling.Generator package is still published for backwards
    compatibility, but new consumers should reference the main package only.

    Bundle the generator DLL the build actually produced. Asking the generator project for its
    target path, instead of hardcoding bin\$(Configuration)\netstandard2.0, follows any output
    redirection such as artifacts-path. The hardcoded path silently bundled whatever stale DLL
    sat in the repository's bin folder, at whatever version that DLL had been built with.
    See ZeroAlloc-Net/.github#43.
  -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.Scheduling.Generator\ZeroAlloc.Scheduling.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroAllocSchedulingGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ZeroAllocSchedulingGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
